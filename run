#!/usr/bin/env bash
# Matches the `./run before` / `./run after` invocation named in
# arm-hackathon-plan.md §3 Component A's definition of done.
set -euo pipefail
cd "$(dirname "$0")"

case "${1:-}" in
  before) exec ./run-before.sh ;;
  after)  exec ./run-after.sh ;;
  cbom)   exec python3 component-c/cbom/generate_cbom.py "${2:-after}" ;;
  cbom-validate) exec python3 component-c/cbom/validate_cbom.py ;;
  *)
    echo "usage: ./run {before|after|cbom [before|after]|cbom-validate}" >&2
    exit 1
    ;;
esac
