<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.latticejack</groupId>
  <artifactId>pqc-migration</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Latticejack PQC Migration</name>
  <description>
    Java TLS/mTLS migration reference from classical crypto (RSA/ECDSA/X25519)
    to hybrid post-quantum crypto (ML-KEM/ML-DSA), optimized for Arm64.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>com.latticejack.pqc.EchoTlsServer</exec.mainClass>

    <!--
      Confirmed 2026-07-28 (docs/bouncycastle-pqc-notes.md): BC Java 1.85 is
      current; bctls-jdk18on provides the BCJSSE provider. Hybrid X25519MLKEM768
      key exchange works via these; ML-DSA TLS cert auth is still experimental
      upstream and NOT wired here yet (see notes doc + run-after.sh).
    -->
    <bouncycastle.version>1.85</bouncycastle.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bctls-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>pqc-migration</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!--
            Required by src/main/java/com/latticejack/pqc/nativekem/ (the
            opt-in native ML-KEM path, -Dlatticejack.tls.nativekem=true),
            which uses java.lang.foreign, a JDK 21 PREVIEW API (finalized in
            JDK 22). Maven's compiler plugin compiles all of src/main/java in
            ONE javac invocation, so this marks EVERY class in the module as
            a preview class, not just the new ones: it means every java
            invocation project-wide now needs the enable preview runtime
            flag too, including run-before.sh/run-after.sh/run-benchmark.sh,
            which don't touch this code at all. Accepted, precedented cost
            (see benchmarks/mlkem-ffm-bench, which already required this for
            its own separate compile/run) - see those scripts for the
            matching runtime flag.
          -->
          <compilerArgs>
            <arg>--enable-preview</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
          <!-- Classes are now compiled as preview (see maven-compiler-plugin
               above) - mvn exec:java would otherwise fail loudly with
               "preview features not enabled" even though no run script
               actually uses this goal today. -->
          <options>
            <option>--enable-preview</option>
          </options>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <!-- Same reason as exec-maven-plugin above: no test sources
               reference preview APIs today, but the whole module's classes
               are preview-flagged, so any future test would need this. -->
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
