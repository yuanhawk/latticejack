target/
vendor/
*.class
*.log
.idea/
*.iml
.vscode/
.DS_Store

# Never commit - this repo is public. Nothing in this project's own code
# reads a root-level .env (demo/worker/ has its own separate, already
# -gitignored .dev.vars for Cloudflare Worker local dev secrets - see
# demo/worker/.gitignore) - a stray .env here has only ever meant someone
# saved real or real-looking credentials/IDs to a file for safekeeping.
# Ignored defensively so that can never be swept up by a future `git add`.
.env
.env.*
!.env.*.example

# Generated keystores/certs (regenerated by scripts/gen-*.sh, never commit private key material)
keys/**/*.jks
keys/**/*.p12
keys/**/*.pem
keys/**/*.key
keys/**/*.crt
keys/**/*.csr
!keys/.gitkeep

# Benchmark result CSVs regenerate per-run (see run-benchmark.sh) and are
# only meaningful tied to the hardware they were measured on - don't commit
# a dev-machine run as if it were the official Arm64 numbers.
benchmarks/results/*.csv
!benchmarks/results/.gitkeep

# component-ai/: local-prototype-only llama.cpp build tooling (component-ai/README.md)
# - a full third-party git clone (its own .git/, ~700MB build output) and a
# ~773MB downloaded GGUF model file. Neither belongs in this repo's history;
# both are reproducible from component-ai/README.md's exact commands.
component-ai/llama.cpp/
component-ai/models/
