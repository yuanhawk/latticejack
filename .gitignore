target/
vendor/
*.class
*.log
.idea/
*.iml
.vscode/
.DS_Store

# Generated keystores/certs (regenerated by scripts/gen-*.sh, never commit private key material)
keys/**/*.jks
keys/**/*.p12
keys/**/*.pem
keys/**/*.key
keys/**/*.crt
keys/**/*.csr
!keys/.gitkeep

# Benchmark result CSVs regenerate per-run (see run-benchmark.sh) and are
# only meaningful tied to the hardware they were measured on - don't commit
# a dev-machine run as if it were the official Arm64 numbers.
benchmarks/results/*.csv
!benchmarks/results/.gitkeep
